The first debug rollup is working and shows repeated 8-hop patterns. I’m now collapsing those into unique `Route` strings, ranking by hop count and latest departure date, and using that same tested shape for the final SQL and proof queries.
tool altinity_ontime_demo.execute_query({"query":"WITH itineraries AS (\n    SELECT\n        FlightDate,\n        TailNum AS aircraft_id,\n        FlightNum AS flight_number,\n        Carrier AS carrier,\n        arraySort(x -> (x.1, x.2, x.3), groupArray((coalesce(DepTime, CRSDepTime, toUInt16(0)), OriginCode, DestCode))) AS legs\n    FROM ontime.fact_ontime\n    WHERE Cancelled = 0\n      AND TailNum != ''\n      AND FlightNum != ''\n    GROUP BY FlightDate, aircraft_id, flight_number, carrier\n    HAVING count() > 1\n), ranked AS (\n    SELECT\n        FlightDate,\n        aircraft_id,\n        flight_number,\n        carrier,\n        length(legs) AS hop_count,\n        arrayStringConcat(arrayMap(x -> x.2, legs), '-') || '-' || arrayElement(legs, -1).3 AS Route\n    FROM itineraries\n), deduped AS (\n    SELECT *, row_number() OVER (PARTITION BY Route ORDER BY hop_count DESC, FlightDate DESC, aircraft_id DESC, flight_number DESC, carrier DESC) AS route_rank\n    FROM ranked\n)\nSELECT FlightDate, aircraft_id, flight_number, carrier, hop_count, Route\nFROM deduped\nWHERE route_rank = 1\nORDER BY hop_count DESC, FlightDate DESC, Route ASC\nLIMIT 15","limit":50})
